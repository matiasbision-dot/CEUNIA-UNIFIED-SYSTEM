import random

weights = {
    "openai": 1.0,
    "claude": 1.0
}

def ceunia_router(task_type="general"):
    """
    Selects model based on simple weighted policy.
    Future: replace with coherence + risk + memory signals.
    """
    models = list(weights.keys())
    scores = list(weights.values())

    # soft selection (not deterministic yet)
    return random.choices(models, weights=scores, k=1)[0]
